#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define ZMK_POINTING_DEFAULT_SCRL_VAL 100
#define MOUSE 5
#define SCROLL 6

&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
};

/ {
    combos { compatible = "zmk,combos"; };

    macros {
        to_layer_0: to_layer_0 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&to 0 &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "TO_LAYER_0";
        };
    };

    behaviors {
        lt_to_layer_0: lt_to_layer_0 {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_TO_0";
            bindings = <&mo>, <&to_layer_0>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };

        scroll_up_down: behavior_sensor_rotate_mouse_wheel_up_down {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_UP>, <&msc SCRL_DOWN>;

            tap-ms = <20>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp Q        &kp W         &kp E         &kp R        &kp T                                                           &kp Y        &kp U  &lt 5 I   &kp O         &kp P
&kp A        &kp S         &kp D         &kp F        &kp G                                         &kp LEFT_CONTROL  &kp H        &kp J  &kp K     &kp L         &mkp MB4
&kp Z        &kp X         &kp C         &kp V        &kp B                 &mt LEFT_CONTROL TAB    &kp DEL           &kp N        &kp M  &mkp MB1  &lt 6 PERIOD  &mkp MB2
&lt 4 GRAVE  &kp LEFT_WIN  &kp LEFT_ALT  &lt 2 SPACE  &mt LEFT_SHIFT SPACE  &lt 3 SPACE             &kp BACKSPACE     &lt 1 ENTER                                 &mkp MB5
            >;

            sensor-bindings = <&scroll_up_down>;
        };

        layer_1 {
            bindings = <
&kp TAB  &trans  &kp N7        &kp N8        &kp N9                                   &kp ESCAPE     &kp F2          &kp PSCRN       &kp F11          &kp F12
&trans   &trans  &kp NUMBER_4  &kp N5        &kp NUMBER_6               &kp E         &kp PAGE_UP    &kp F2          &kp UP_ARROW    &trans           &kp LC(V)
&trans   &trans  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp TAB      &kp LEFT_WIN  &kp PAGE_DOWN  &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW  &kp LC(C)
&trans   &trans  &kp PERIOD    &kp PERIOD    &kp N0        &kp SPACE    &trans        &trans                                                          &kp LC(Z)
            >;

            sensor-bindings = <&scroll_up_down>;
        };

        layer_2 {
            bindings = <
&kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp NUMBER_4  &trans                             &kp CARET         &kp AMPERSAND      &kp TILDE  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS
&trans        &trans        &trans        &trans        &kp ESC            &kp UNDERSCORE  &kp EXCLAMATION   &kp AT_SIGN        &kp HASH   &kp DOLLAR            &kp PERCENT
&trans        &trans        &trans        &trans        &trans   &trans    &trans          &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &mkp MB1   &mkp MB3              &mkp MB2
&trans        &trans        &trans        &trans        &trans   &trans    &trans          &trans                                                                &kp PIPE
            >;

            sensor-bindings = <&scroll_up_down>;
        };

        layer_3 {
            bindings = <
&kp ESCAPE      &kp LC(LS(TAB))         &kp UP_ARROW    &kp LC(TAB)              &trans                      &trans        &trans           &kp LS(N8)         &kp LEFT_PARENTHESIS  &trans
&kp HOME        &kp LEFT_ARROW          &kp DOWN_ARROW  &kp RIGHT_ARROW          &kp END            &trans   &kp QUESTION  &kp EXCLAMATION  &kp RIGHT_BRACKET  &kp BACKSLASH         &kp SEMICOLON
&kp LEFT_SHIFT  &kp LG(LS(LEFT_ARROW))  &trans          &kp LG(LS(RIGHT_ARROW))  &trans   &trans    &trans   &trans        &trans           &kp COMMA          &kp PERIOD            &kp MINUS
&trans          &trans                  &trans          &trans                   &trans   &trans    &kp DEL  &kp ENTER                                                               &kp SLASH
            >;

            sensor-bindings = <&scroll_up_down>;
        };

        layer_4 {
            bindings = <
&trans  &trans  &trans  &trans  &trans                         &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4
&trans  &trans  &trans  &trans  &trans            &trans       &trans        &trans        &trans        &trans        &trans
&trans  &trans  &trans  &trans  &trans  &trans    &bootloader  &trans        &trans        &trans        &trans        &bt BT_CLR
&trans  &trans  &trans  &trans  &trans  &trans    &trans       &trans                                                  &bt BT_CLR_ALL
            >;

            sensor-bindings = <&scroll_up_down>;
        };

        MOUSE {
            bindings = <
&trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans    &trans        &trans
&trans  &trans  &trans  &trans  &trans            &trans  &trans  &trans  &trans    &trans        &mkp MB4
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &mkp MB1  &lt 6 PERIOD  &mkp MB2
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans                                  &mkp MB5
            >;

            sensor-bindings = <&scroll_up_down>;
        };

        SCROLL {
            bindings = <
&trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans            &trans  &trans
&trans  &trans  &trans  &trans  &trans            &trans  &trans  &trans  &trans            &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &kp LEFT_CONTROL  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans                                    &trans
            >;

            sensor-bindings = <&scroll_up_down>;
        };
    };
};
